historytalk.app {
    handle /Historical-tell/* {
        reverse_proxy historytalk-java:8080 {
            # Streamed chat replies and speech must reach the browser as they are produced
            flush_interval -1
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
            transport http {
                response_header_timeout 600s
            }
        }
    }
    # The AI service is not published: only Java calls it, over the internal Docker network
    # (AI_SERVICE_URL=http://historytalk-ai:8001). A public route let anyone use the LLM and TTS without logging in.

    redir /grafana /grafana/
    handle /grafana/* {
        reverse_proxy http://historytalk-grafana:3000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
            transport http {
                response_header_timeout 600s
            }
        }
    }

    handle_path /historytalkwdp/* {
        reverse_proxy http://historytalk-express:5000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
            transport http {
                response_header_timeout 600s
            }
        }
    }
}
