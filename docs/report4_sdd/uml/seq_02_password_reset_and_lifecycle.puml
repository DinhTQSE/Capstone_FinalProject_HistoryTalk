@startuml
scale max 2800 width
skinparam defaultFontName Arial
skinparam shadowing false
autonumber

title Sequence Diagram 3.1.2 - Password Reset & Admin Account Lifecycle Management

actor "User / Admin" as Actor
participant "Next.js Web UI" as UI
participant "AuthController /\nAdminUserController" as Ctrl
participant "AuthServiceImpl /\nUserServiceImpl" as Svc
participant "PasswordResetEmailService" as Mail
database "UserRepository\n(PostgreSQL)" as Repo

group Flow A: Self-Service Password Reset via SHA-256 Token
    Actor -> UI : Request Forgot Password (email)
    UI -> Ctrl : POST /api/v1/auth/forgot-password
    Ctrl -> Svc : forgotPassword(email)
    Svc -> Repo : findByEmailAndDeletedAtIsNull(email)
    Svc -> Svc : Generate raw token & SHA-256 hash + 15-min expiry
    Svc -> Repo : save(passwordResetTokenHash, passwordResetExpiresAt)
    Svc -> Mail : sendPasswordResetEmail(email, resetLink)
    Mail --> Actor : Deliver Reset Email via SMTP
    Actor -> UI : Submit New Password with Token
    UI -> Ctrl : POST /api/v1/auth/reset-password
    Ctrl -> Svc : resetPassword(token, newPassword)
    Svc -> Repo : findByPasswordResetTokenHash(sha256(token))
    Svc -> Svc : Verify expiry, encode BCrypt password, update lastTokenResetAt
    Svc -> Repo : save(User)
    Svc --> UI : 200 OK (Password updated & old JWTs invalidated)
end

group Flow B: Admin Account Deactivation / Bulk Restore
    Actor -> UI : Select user(s) to Deactivate or Restore
    UI -> Ctrl : PUT /api/v1/admin/users/{uid}/deactivate (or POST /restore)
    Ctrl -> Svc : updateAccountLifecycle(uid, status, reason)
    Svc -> Repo : save(accountStatus = DEACTIVATED, lastTokenResetAt = NOW)
    Svc --> UI : 200 OK (Immediate session revocation)
end
@enduml
