@startuml
skinparam dpi 180
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam shadowing false

title HistoryTalk - Hybrid RAG Ingestion & Conversational AI Roleplay Pipeline

package "Phase 1: Document Ingestion & Semantic Indexing Pipeline" #EBF5FB {
    [1. Document Upload\n(PDF / Markdown / Text)] as Step1
    [2. PDF Type Classifier & Extractor\n(Apache PDFBox 3.0.1 + Tess4J 5.10.0 Vietnamese OCR)] as Step2
    [3. Dynamic Semantic Chunking\n(Sentence Splitting + 80th Percentile Cosine Distance Breakpoints\nmax_chunk_chars = 1200)] as Step3
    [4. Dense Vector Embedding\n(Ollama BAAI/bge-m3 - 768 Dimensions\nSemaphore Concurrency = 15)] as Step4
    database "5. Supabase PgVector Store\n(vector_chunk table - HNSW Index\nm=16, ef_construction=64)" as VecStore
}

package "Phase 2: Retrieval, Reranking & Grounded Persona Generation" #FEF9E7 {
    [A. User Question & Session Context\n(characterId, contextId, message_history)] as QueryIn
    [B. Query Embedding Generation\n(BAAI/bge-m3 768-D Vector with 3x Backoff Retry)] as QueryEmbed
    [C. Vector Similarity Search\n(match_history_chunks RPC - Top 10 Chunks\nfiltered by entity_ids)] as VecSearch
    [D. Cross-Encoder Reranking\n(Kaggle Rerank API /api/rerank\nFallback: Top-2 Cosine Chunks)] as Rerank
    [E. Grounded Persona Prompt Builder\n(1st-Person Roleplay Rules + Zero-Hallucination Guardrail\n+ 30% Socratic Reverse-Questioning)] as PromptBuild
    [F. Streaming LLM Inference\n(Gemma-2-9B-IT / External OpenAI API\nSSE Token Stream + 3 Suggested Follow-up Questions)] as LlmStream
}

Step1 --> Step2 : Raw File Stream
Step2 --> Step3 : Normalized UTF-8 Text
Step3 --> Step4 : Semantic Text Chunks
Step4 --> VecStore : Batch Upsert (100 chunks/batch)

QueryIn --> QueryEmbed : User Prompt
QueryEmbed --> VecSearch : 768-D Query Vector
VecStore --> VecSearch : Cosine Similarity (1 - (<=>))
VecSearch --> Rerank : Top-10 Candidate Chunks
Rerank --> PromptBuild : Top Reranked Historical Passages
PromptBuild --> LlmStream : Assembled Messages Payload
@enduml
